[Unit]
Description=MCServer by Derpchees (agent: game proxy, auto stop, backups, alerts)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/mcpanel/panel/mcpanel-agent.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
