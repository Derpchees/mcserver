#!/bin/bash
#
# Restablece la contrasena de un usuario del panel (por si alguien,
# incluido el administrador, se queda sin acceso).
#
#   sudo mcpanel-passwd <usuario>
#   echo 'clave' | sudo mcpanel-passwd <usuario> --stdin
#   sudo mcpanel-passwd --list
#

CORE="/opt/mcpanel/panel/mcpanel_core.py"

if [ "$(id -u)" -ne 0 ]; then
    echo "Corre este comando con sudo / Run with sudo." >&2
    exit 1
fi

if [ "${1:-}" = "--list" ] || [ -z "${1:-}" ]; then
    python3 - "$CORE" <<'PY'
import sys, importlib.util
spec = importlib.util.spec_from_file_location("core", sys.argv[1])
core = importlib.util.module_from_spec(spec)
spec.loader.exec_module(core)
rows = core.query("SELECT username, role FROM users ORDER BY id")
if not rows:
    print("No hay usuarios todavía; abre el panel para crear el administrador.")
for row in rows:
    print("%-24s %s" % (row["username"], row["role"]))
PY
    [ -z "${1:-}" ] && echo && echo "Uso: sudo mcpanel-passwd <usuario>"
    exit 0
fi

user="$1"

if [ "${2:-}" = "--stdin" ]; then
    IFS= read -r password
else
    read -r -s -p "Nueva contraseña / New password: " password; echo
    read -r -s -p "Repítela / Repeat it: " again; echo
    [ "$password" = "$again" ] || { echo "No coinciden / They do not match." >&2; exit 1; }
fi

[ "${#password}" -ge 6 ] || { echo "Mínimo 6 caracteres / At least 6 characters." >&2; exit 1; }

MCPANEL_USER="$user" MCPANEL_PASSWORD="$password" python3 - "$CORE" <<'PY'
import os, sys, importlib.util
spec = importlib.util.spec_from_file_location("core", sys.argv[1])
core = importlib.util.module_from_spec(spec)
spec.loader.exec_module(core)
user = core.find_user(os.environ["MCPANEL_USER"])
if not user:
    print("No existe el usuario / No such user: " + os.environ["MCPANEL_USER"], file=sys.stderr)
    sys.exit(1)
core.execute("UPDATE users SET password = ? WHERE id = ?",
             (core.hash_password(os.environ["MCPANEL_PASSWORD"]), user["id"]))
print("Contraseña actualizada / Password updated: " + user["username"])
PY
