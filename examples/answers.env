# Respuestas para instalar sin preguntas:
#   sudo ./install.sh --config examples/answers.env
#
# Answers for a non-interactive install. Every line is optional except
# ACCEPT_EULA and PASSWORD; missing values use the defaults shown here.

# Required: https://aka.ms/MinecraftEULA
ACCEPT_EULA="no"
PASSWORD="change-me"

SERVER_NAME="Minecraft Server"
UI_LANG="en"                      # en | es (panel default language)

TYPE="PAPER"                      # FORGE | FABRIC | PAPER | VANILLA
VERSION_MC="LATEST"               # e.g. 1.20.1

MAX_GB="4"                        # RAM for Minecraft (GB)
CPU_LIMIT="0"                     # CPU cores, 0 = no limit

DATA_DIR="/srv/minecraft/server"
BACKUP_DIR="/srv/minecraft/backups"

LISTEN_IP="0.0.0.0"               # or one IP, e.g. your ZeroTier/Tailscale address
GAME_PORT="25565"
PANEL_PORT="8090"
PUBLIC_ADDRESS=""                 # shown in the panel; default <ip>:<GAME_PORT>

AUTOSTOP="yes"                    # start on connect, stop when empty
IDLE_MINUTES="10"

BACKUPS="yes"
BACKUP_TIME="04:00"               # server local time
BACKUP_KEEP_AUTO="3"

# Advanced
# CONTAINER="mcpanel-minecraft"
# MC_INTERNAL_PORT="25566"        # Minecraft inside Docker, only on 127.0.0.1
# MC_UID="1000"
# MC_GID="1000"
