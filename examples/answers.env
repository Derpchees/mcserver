# Respuestas para instalar sin preguntas:
#   sudo ./install.sh --config examples/answers.env
#
# Answers for a non-interactive install. Every line is optional except
# ACCEPT_EULA; missing values use the defaults shown here.

# Required: https://aka.ms/MinecraftEULA
ACCEPT_EULA="no"

UI_LANG="en"                          # en | es (panel default language)

DATA_ROOT="/srv/minecraft/servers"    # one folder per server inside
BACKUP_ROOT="/srv/minecraft/backups"

LISTEN_IP="0.0.0.0"                   # or one IP, e.g. your ZeroTier/Tailscale address
PANEL_PORT="8090"
GAME_PORT_START="25565"               # each new server takes the next free port
PUBLIC_HOST=""                        # IP or domain players use; default: this machine's IP

# Secure access (HTTPS). Browsers need it for notifications.
# Recommended: a free DuckDNS domain (duckdns.org) with a Let's Encrypt
# certificate; devices install nothing. It points to your VPN or LAN IP.
# DUCKDNS_SUBDOMAIN="my-server"       # -> https://my-server.duckdns.org:PANEL_PORT
# DUCKDNS_TOKEN="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Without DuckDNS data: "local" = the server's own certificate authority
# (each device installs it once from /ca.crt), or "no".
HTTPS="local"                         # local | no

# Optional: create the administrator now instead of in the browser
# ADMIN_USER="admin"
# ADMIN_PASSWORD="change-me"

# Advanced
# MC_UID="1000"
# MC_GID="1000"
